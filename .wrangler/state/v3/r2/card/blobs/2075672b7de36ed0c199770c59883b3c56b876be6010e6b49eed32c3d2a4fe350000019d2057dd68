ow">\n          <span class="keepalive-dot" :class="{ active: notifyPermission === \'granted\' }"></span>\n          <span>生成完畢通知：{{ notifyLabel }}</span>\n        </div>\n        <p class="keepalive-hint">iOS 需加到主畫面以 PWA 模式開啟才能收到鎖屏通知</p>\n        <div class="keepalive-btn-row">\n          <button class="menu_button keepalive-btn" :disabled="notifyPermission === \'denied\'" @click="requestNotify">\n            {{\n              notifyPermission === \'granted\'\n                ? \'✅ 已授權\'\n                : notifyPermission === \'denied\'\n                  ? \'🚫 已拒絕（請至系統設定開啟）\'\n                  : \'🔔 申請通知權限\'\n            }}\n          </button>\n        </div>\n      </div>\n\n      <div class="keepalive-section">\n        <label class="keepalive-checkbox-label">\n          <input v-model="settings.showQrButton" type="checkbox" />\n          在 QR 顯示保活按鈕\n        </label>\n        <p class="keepalive-hint">啟用後，QR 欄會出現「▶ 啟動保活」/「⏹ 停止保活」按鈕，狀態與實際保活同步</p>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang="ts">\nimport { klona } from \'klona\';\nimport { computed, onUnmounted, ref, watch } from \'vue\';\n\n// ===== 多層保活策略（移植自 aguaphone/useBackgroundAudio.ts）=====\n// 1. Web Lock：讓瀏覽器認為頁面「正在做重要事情」，不輕易回收\n// 2. 靜音 OscillatorNode：1Hz + gain 0.001，不出聲也不觸發系統媒體控制欄\n// 3. 靜音 <audio> 循環播放 + Media Session：移動端保活關鍵\n// 4. Web Worker 心跳：每 15 秒 ping 主線程，檢查 AudioContext 是否被掛起\n// 5. BroadcastChannel 自我心跳：Worker 被殺時的備用喚醒機制\n// 6. Page Lifecycle（freeze/resume）：頁面凍結恢復後重建所有保活層\n// 7. visibilitychange 恢復：切回前台時重新確認所有保活層都在運作\n\nconst SILENT_AUDIO_URL = \'https://bqb.aguacloud.uk/%E7%84%A1%E8%81%B2%E9%9F%B3%E9%A0%BB10%E5%88%86%E9%90%98.m4a\';\nconst QR_BUTTON_NAME = \'▶ 啟動保活\';\nconst QR_BUTTON_NAME_STOP = \'⏹ 停止保活\';\n\n// --- 設定（持久化到 script 變量）---\nconst Settings = z\n  .object({\n    showQrButton: z.boolean().default(false),\n    streamMode: z.enum([\'audio\', \'mic\', \'camera\']).default(\'audio\'),\n  })\n  .prefault({});\nconst settings = ref(Settings.parse(getVariables({ type: \'script\' })));\nwatch(settings, val => replaceVariables(klona(val), { type: \'script\' }), { deep: true });\n\n// --- 保活狀態 ---\nconst isPlaying = ref(false);\n\n// 內部狀態\nlet audioCtx: AudioContext | null = null;\nlet oscillator: OscillatorNode | null = null;\nlet gainNode: GainNode | null = null;\nlet silentAudioEl: HTMLAudioElement | null = null;\nlet heartbeatWorker: Worker | null = null;\nlet workerBlobUrl: string | null = null;\nlet webLockAbortController: AbortController | null = null;\nlet broadcastChannel: BroadcastChannel | null = null;\nlet broadcastTimer: ReturnType<typeof setInterval> | null = null;\nlet userInteracted = false;\n\n// ---------- 麥克風 / 鏡頭串流保活 ----------\nlet micStream: MediaStream | null = null;\nconst streamPermission = ref<\'unknown\' | \'granted\' | \'denied\'>(\'unknown\');\n\nasync function startMediaStream() {\n  if (micStream) return;\n  const isMic = settings.value.streamMode === \'mic\';\n  const constraints = isMic ? { audio: true, video: false } : { audio: false, video: true };\n  try {\n    micStream = await navigator.mediaDevices.getUserMedia(constraints);\n    streamPermission.value = \'granted\';\n    console.info(`[保活] ${isMic ? \'麥克風\' : \'鏡頭\'}串流已啟動`);\n  } catch (e: any) {\n    streamPermission.value = e?.name === \'NotAllowedError\' ? \'denied\' : \'unknown\';\n    console.warn(`[保活] ${isMic ? \'麥克風\' : \'鏡頭\'}串流啟動失敗:`, e);\n  }\n}\n\nfunction stopMediaStream() {\n  if (!micStream) return;\n  micStream.getTracks().forEach(t => t.stop());\n  micStream = null;\n  console.info(\'[保活] 串流已停止\');\n}\n\nfunction onModeChange() {\n  if (isPlaying.value) {\n    stop();\n    start();\n  }\n}\n\n// ---------- Web Lock ----------\nfunction acquireWebLock() {\n  releaseWebLock();\n  if (!(\'locks\' in navigator)) return;\n  webLockAbortController = new AbortController();\n  navigator.locks\n    .request(\'tavern-keep-alive\', { signal: webLockAbortController.signal }, () => new Promise<void>(() => {}))\n    .catch(e => {\n      if (e.name !== \'AbortError\') console.warn(\'[保活] Web Lock 失敗:\', e);\n    });\n}\n\nfunction releaseWebLock() {\n  webLockAbortController?.abort();\n  webLockAbortController = null;\n}\n\n// ---------- 靜音振盪器 ----------\nfunction startSilentOscillator() {\n  if (audioCtx) return;\n  try {\n    audioCtx = new AudioContext();\n    gainNode = audioCtx.createGain();\n    gainNode.gain.value = 0.001;\n    oscillator = audioCtx.createOscillator();\n    oscillator.frequency.value = 1;\n    oscillator.connect(gainNode);\n    gainNode.connect(audioCtx.destination);\n    oscillator.start();\n  } catch (e) {\n    console.warn(\'[保活] 振盪器啟動失敗:\', e);\n  }\n}\n\nfunction stopSilentOscillator() {\n  try {\n    oscillator?.stop();\n  } catch (_e) {\n    /* 已停止 */\n  }\n  oscillator?.disconnect();\n  oscillator = null;\n  gainNode?.disconnect();\n  gainNode = null;\n  audioCtx?.close().catch(() => {});\n  audioCtx = null;\n}\n\n// ---------- 靜音 <audio> + Media Session ----------\nfunction setupMediaSession() {\n  if (!(\'mediaSession\' in navigator)) return;\n  navigator.mediaSession.metadata = new MediaMetadata({ title: \'保活中\', artist: \'SillyTavern\' });\n  navigator.mediaSession.setActionHandler(\'play\', () => silentAudioEl?.play().catch(() => {}));\n  navigator.mediaSession.setActionHandler(\'pause\', () => silentAudioEl?.play().catch(() => {}));\n}\n\nfunction startSilentAudio() {\n  if (silentAudioEl) return;\n  try {\n    silentAudioEl = new Audio(SILENT_AUDIO_URL);\n    silentAudioEl.loop = true;\n    silentAudioEl.volume = 0.001;\n    // loop 保險：ended 時手動重播\n    silentAudioEl.addEventListener(\'ended\', () => {\n      if (isPlaying.value) silentAudioEl?.play().catch(() => {});\n    });\n    // 被系統暫停時自動恢復\n    silentAudioEl.addEventListener(\'pause\', () => {\n      if (isPlaying.value) setTimeout(() => silentAudioEl?.play().catch(() => {}), 500);\n    });\n    silentAudioEl\n      .play()\n      .then(() => {\n        setupMediaSession();\n        console.info(\'[保活] 靜音音頻已啟動\');\n      })\n      .catch(e => console.warn(\'[保活] 靜音音頻播放失敗:\', e));\n  } catch (e) {\n    console.warn(\'[保活] 靜音音頻建立失敗:\', e);\n  }\n}\n\nfunction stopSilentAudio() {\n  if (silentAudioEl) {\n    silentAudioEl.pause();\n    silentAudioEl.src = \'\';\n    silentAudioEl.load();\n    silentAudioEl = null;\n  }\n  if (\'mediaSession\' in navigator) {\n    navigator.mediaSession.metadata = null;\n    navigator.mediaSession.setActionHandler(\'play\', null);\n    navigator.mediaSession.setActionHandler(\'pause\', null);\n  }\n}\n\nfunction resumeAudioIfNeeded() {\n  if (!isPlaying.value) return;\n  // 恢復 AudioContext\n  if (audioCtx?.state === \'suspended\') audioCtx.resume().catch(() => {});\n  else if (!audioCtx && userInteracted) startSilentOscillator();\n  // 恢復 <audio>\n  if (silentAudioEl?.paused) silentAudioEl.play().catch(() => {});\n  else if (!silentAudioEl && userInteracted) startSilentAudio();\n}\n\n// ---------- Web Worker 心跳 ----------\nfunction startHeartbeatWorker() {\n  if (heartbeatWorker) return;\n  const code = `\n    let t=null;\n    self.onmessage=e=>{\n      if(e.data===\'start\') t=setInterval(()=>{\n        self.postMessage(\'ping\');\n        try{fetch(self.location.origin||\'/\',{method:\'HEAD\',mode:\'no-cors\'}).catch(()=>{})}catch{}\n      },15000);\n      else if(e.data===\'stop\'){clearInterval(t);t=null;}\n    };\n  `;\n  const blob = new Blob([code], { type: \'application/javascript\' });\n  workerBlobUrl = URL.createObjectURL(blob);\n  heartbeatWorker = new Worker(workerBlobUrl);\n  heartbeatWorker.onmessage = () => resumeAudioIfNeeded();\n  heartbeatWorker.onerror = () => {\n    console.warn(\'[保活] 心跳 Worker 終止，重啟中\');\n    cleanupWorker();\n    if (isPlaying.value) setTimeout(startHeartbeatWorker, 1000);\n  };\n  heartbeatWorker.postMessage(\'start\');\n}\n\nfunction cleanupWorker() {\n  heartbeatWorker?.postMessage(\'stop\');\n  heartbeatWorker?.terminate();\n  heartbeatWorker = null;\n  if (workerBlobUrl) {\n    URL.revokeObjectURL(workerBlobUrl);\n    workerBlobUrl = null;\n  }\n}\n\n// ---------- BroadcastChannel 備用心跳 ----------\nfunction startBroadcastHeartbeat() {\n  if (broadcastChannel) return;\n  try {\n    broadcastChannel = new BroadcastChannel(\'tavern-keepalive\');\n    broadcastChannel.onmessage = () => {\n      resumeAudioIfNeeded();\n      if (!heartbeatWorker && isPlaying.value) startHeartbeatWorker();\n    };\n    broadcastTimer = setInterval(() => {\n      try {\n        broadcastChannel?.postMessage(\'heartbeat\');\n      } catch (_e) {\n        /* channel 可能已關閉 */\n      }\n    }, 30000);\n  } catch {\n    console.warn(\'[保活] BroadcastChannel 不支援\');\n  }\n}\n\nfunction stopBroadcastHeartbeat() {\n  if (broadcastTimer) {\n    clearInterval(broadcastTimer);\n    broadcastTimer = null;\n  }\n  broadcastChannel?.close();\n  broadcastChannel = null;\n}\n\n// ---------- 用戶互動偵測 ----------\nfunction onFirstInteraction() {\n  if (userInteracted) return;\n  userInteracted = true;\n  window.parent.document.removeEventListener(\'click\', onFirstInteraction, { capture: true });\n  window.parent.document.removeEventListener(\'touchstart\', onFirstInteraction, { capture: true });\n  if (isPlaying.value) {\n    startSilentOscillator();\n    startSilentAudio();\n  }\n}\n\n// ---------- 頁面生命週期 ----------\nfunction handleVisibility() {\n  if (document.visibilityState === \'visible\' && isPlaying.value) {\n    if (settings.value.streamMode === \'audio\') resumeAudioIfNeeded();\n    else if (!micStream) startMediaStream();\n    if (!webLockAbortController) acquireWebLock();\n    if (!heartbeatWorker) startHeartbeatWorker();\n  }\n}\n\nfunction handleResume() {\n  if (!isPlaying.value) return;\n  if (settings.value.streamMode === \'audio\') resumeAudioIfNeeded();\n  else if (!micStream) startMediaStream();\n  if (!webLockAbortController) acquireWebLock();\n  if (!heartbeatWorker) startHeartbeatWorker();\n  if (!broadcastChannel) startBroadcastHeartbeat();\n}\n\n// ---------- QR 按鈕同步 ----------\nfunction syncQrButtons(playing: boolean) {\n  if (!settings.value.showQrButton) {\n    updateScriptButtonsWith(buttons =>\n      buttons.filter(b => b.name !== QR_BUTTON_NAME && b.name !== QR_BUTTON_NAME_STOP),\n    );\n    return;\n  }\n  updateScriptButtonsWith(buttons => [\n    ...buttons.filter(b => b.name !== QR_BUTTON_NAME && b.name !== QR_BUTTON_NAME_STOP),\n    { name: QR_BUTTON_NAME, visible: !playing },\n    { name: QR_BUTTON_NAME_STOP, visible: playing },\n  ]);\n}\n\nwatch(\n  () => settings.value.showQrButton,\n  () => syncQrButtons(isPlaying.value),\n);\n\n// ---------- 主控 ----------\nfunction start() {\n  if (isPlaying.value) return;\n  isPlaying.value = true;\n\n  acquireWebLock();\n  startHeartbeatWorker();\n  startBroadcastHeartbeat();\n\n  if (settings.value.streamMode !== \'audio\') {\n    startMediaStream();\n  } else if (userInteracted) {\n    startSilentOscillator();\n    startSilentAudio();\n  } else {\n    window.parent.document.addEventListener(\'click\', onFirstInteraction, { once: true, capture: true });\n    window.parent.document.addEventListener(\'touchstart\', onFirstInteraction, { once: true, capture: true });\n  }\n\n  document.addEventListener(\'visibilitychange\', handleVisibility);\n  document.addEventListener(\'resume\', handleResume);\n  syncQrButtons(true);\n  console.info(`[保活] 已啟動（${settings.value.streamMode} 模式）`);\n}\n\nfunction stop() {\n  if (!isPlaying.value) return;\n  isPlaying.value = false;\n\n  releaseWebLock();\n  stopMediaStream();\n  stopSilentOscillator();\n  stopSilentAudio();\n  cleanupWorker();\n  stopBroadcastHeartbeat();\n  window.parent.document.removeEventListener(\'click\', onFirstInteraction, { capture: true });\n  window.parent.document.removeEventListener(\'touchstart\', onFirstInteraction, { capture: true });\n  document.removeEventListener(\'visibilitychange\', handleVisibility);\n  document.removeEventListener(\'resume\', handleResume);\n  syncQrButtons(false);\n  console.info(\