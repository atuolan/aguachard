    "场景": {
      "default": {},
      "type": "object",
      "properties": {
        "事件完成": {
          "default": "",
          "type": "string"
        },
        "表态": {
          "default": "",
          "type": "string"
        }
      }
    },
    "_状态": {
      "default": {},
      "type": "object",
      "properties": {
        "每日": {
          "default": {},
          "type": "object",
          "properties": {
            "日期": {
              "default": "",
              "type": "string"
            },
            "冷淡值": {
              "$ref": "#/$defs/__schema0"
            },
            "亲密值": {
              "$ref": "#/$defs/__schema0"
            }
          }
