              "default": 99,
              "type": "number"
            },
            "袋": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "__schema0": {
      "default": {},
      "type": "object",
      "properties": {
        "累计": {
          "default": 0,
          "type": "number"
        },
        "锁定": {
          "default": false,
          "type": "boolean"
        }
      }
    }
  }
}