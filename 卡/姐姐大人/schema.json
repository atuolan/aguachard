    "关系": {
      "default": {},
      "type": "object",
      "properties": {
        "现实": {
          "default": "同事",
          "type": "string",
          "enum": [
            "陌生",
            "同事",
            "朋友",
            "暧昧",
            "恋人",
            "伴侣"
          ]
        },
        "线上": {
          "default": "无",
          "type": "string",
          "enum": [
            "无",
            "网友",
            "熟网友",
            "暧昧",
            "网恋"
          ]
        }
      }
