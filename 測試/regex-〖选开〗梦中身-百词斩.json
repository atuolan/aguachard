  "findRegex": "/\\[\\[([^\\]:]+):([^\\]:]+):([^\\]:]+):([^\\]]+)\\]\\]/g",
  "replaceString": "<span class=\"wbox\" tabindex=\"0\"><span class=\"wtrig\">$1</span><span class=\"wpop\"><span style=\"display:block;font-size:1em;font-weight:900;color:#1a1208;text-align:center;letter-spacing:3px;padding:12px 16px 4px;text-transform:uppercase\">$1</span><span style=\"display:block;text-align:center;font-size:0.8em;color:#a08050;letter-spacing:2px;padding:0 16px 10px;border-bottom:1px solid #e8d8b0\">/ $3 /</span><span style=\"display:block;font-size:0.88em;font-weight:700;color:#3a2e1a;margin:10px 16px;padding:7px 10px;background:#f5ead0;border-radius:2px;text-align:center;letter-spacing:1px\">$2</span><span style=\"display:block;font-size:0.75em;color:#7a6a4a;line-height:1.9;border-top:1px solid #e8d8b0;padding:10px 16px;letter-spacing:0.5px\">$4</span></span><style>.wbox{display:inline-block;position:relative;outline:none;vertical-align:baseline}.wbox .wtrig{border-bottom:2px dashed #c8a96e;color:#c8a96e;cursor:pointer;padding-bottom:1px;font-weight:bold;letter-spacing:1px}.wbox .wpop{display:none;position:absolute;left:0;right:auto;bottom:1.6em;top:auto;min-width:min(240px,78vw);max-width:min(300px,88vw);max-height:min(52vh,320px);overflow-y:auto;background:#fdf6e3;color:#3a2e1a;padding:0;border-radius:3px;z-index:9999;box-shadow:0 12px 40px rgba(0,0,0,0.25);border-top:3px solid #c8a96e}.wbox:focus .wpop,.wbox:focus-within .wpop{display:block}.wbox:focus .wtrig,.wbox:focus-within .wtrig{color:#a07830}</style></span>",
  "trimStrings": [],
  "placement": [1, 2],
  "disabled": false,
